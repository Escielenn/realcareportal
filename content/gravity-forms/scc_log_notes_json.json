    "content": "<div style=\"text-align:center;margin-bottom:20px;padding:15px;background:#f5f5f5;border-bottom:3px solid #333\">\n  <h2 style=\"margin:0 0 5px;font-size:19px;font-weight:bold\">Real Care, Inc. Supported Community Connections Log Notes</h2>\n  <p style=\"margin:0;font-size:13px;font-weight:bold\">DAILY RECEIPT FOR SERVICES</p>\n</div>",

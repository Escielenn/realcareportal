    "content": "<div id=\"res-grid\" class=\"rcc-wrap\">\n  <style>\n    .rcc-wrap{font-family:system-ui,sans-serif;font-size:13px;max-width:100%;margin:15px 0}\n    .rcc-head{display:flex;gap:8px;align-items:center;margin:8px 0 10px;flex-wrap:wrap}\n    .rcc-head h3{margin:0;font-size:15px;flex:1}\n    .rcc-head button{font-size:12px;padding:6px 12px;cursor:pointer;border:1px solid #999;background:#f5f5f5;border-radius:3px}\n    .rcc-head button:hover{background:#e8e8e8}\n    .grid-container{overflow-x:auto;border:1px solid #ccc;background:#f9f9f9;padding:10px}\n    .grid-instructions{background:#fff8dc;padding:8px;margin-bottom:10px;font-size:12px;border-left:3px solid #ff9800}\n    table.day-grid{width:100%;border-collapse:collapse;table-layout:fixed;min-width:800px}\n    .day-grid th,.day-grid td{border:1px solid #999;padding:8px;text-align:center;min-width:28px}\n    .day-grid th{background:#d9d9d9;font-weight:600;font-size:12px}\n    .day-grid td{background:#fff;cursor:pointer;user-select:none;height:35px;font-size:13px;font-weight:600}\n    .day-grid td:hover{background:#e3f2fd}\n    .day-grid td.marked{background:#c8e6c9;color:#1b5e20}\n    .day-grid td.coded{background:#fff9c4;color:#f57f17;font-size:11px}\n    .muted{font-size:11px;color:#666;margin:8px 0 0}\n  </style>\n\n  <div class=\"rcc-head\">\n    <h3>Residential Services - Click days to mark with X</h3>\n    <button type=\"button\" id=\"res-clear\">Clear All</button>\n  </div>\n\n  <div class=\"grid-instructions\">\n    <strong>Instructions:</strong> Click any date to mark it with an \"X\" indicating service was provided. You can also type special codes (E, H, R, V, I, T, VT, J) directly in the cells. See legend below for code meanings.\n  </div>\n\n  <div class=\"grid-container\">\n    <table class=\"day-grid\">\n      <thead>\n        <tr id=\"res-header\"></tr>\n      </thead>\n      <tbody>\n        <tr id=\"res-days\"></tr>\n      </tbody>\n    </table>\n  </div>\n  \n  <p class=\"muted\">Your selections save automatically. Click \"Clear All\" to start over.</p>\n</div>\n\n<script>\n(function(){\n  const STORAGE_KEY = 'medicaid_residential_v1';\n  const header = document.getElementById('res-header');\n  const days = document.getElementById('res-days');\n  const clearBtn = document.getElementById('res-clear');\n\n  function loadState(){\n    try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; }\n    catch(e){ return {}; }\n  }\n  function saveState(state){\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));\n  }\n\n  const state = loadState();\n\n  for (let day=1; day<=31; day++){\n    const th = document.createElement('th');\n    th.textContent = day;\n    header.appendChild(th);\n\n    const td = document.createElement('td');\n    td.setAttribute('data-day', day);\n    td.setAttribute('aria-label', 'Day '+day);\n    \n    const val = state[day] || '';\n    td.textContent = val;\n    if(val === 'X') td.classList.add('marked');\n    else if(val) td.classList.add('coded');\n\n    td.addEventListener('click', function(){\n      const current = td.textContent.trim();\n      if(current === ''){\n        td.textContent = 'X';\n        td.classList.add('marked');\n        td.classList.remove('coded');\n      } else {\n        td.textContent = '';\n        td.classList.remove('marked', 'coded');\n      }\n      persist();\n    });\n\n    td.addEventListener('dblclick', function(){\n      const code = prompt('Enter special code (E, H, R, V, I, T, VT, J) or leave blank for X:', td.textContent);\n      if(code === null) return;\n      const trimmed = code.trim().toUpperCase();\n      td.textContent = trimmed;\n      td.classList.remove('marked', 'coded');\n      if(trimmed === 'X') td.classList.add('marked');\n      else if(trimmed) td.classList.add('coded');\n      persist();\n    });\n\n    days.appendChild(td);\n  }\n\n  function persist(){\n    const s = {};\n    document.querySelectorAll('#res-days td').forEach(td=>{\n      const day = td.getAttribute('data-day');\n      const val = td.textContent.trim();\n      if(val) s[day] = val;\n    });\n    saveState(s);\n    updateTotal();\n  }\n\n  function updateTotal(){\n    const s = loadState();\n    const total = Object.keys(s).filter(k => s[k]).length;\n    const input = document.querySelector('input[name=\"input_11\"]');\n    if(input) input.value = total;\n  }\n\n  clearBtn.addEventListener('click', ()=>{\n    if(!confirm('Clear all residential service days?')) return;\n    localStorage.removeItem(STORAGE_KEY);\n    document.querySelectorAll('#res-days td').forEach(td=>{\n      td.textContent = '';\n      td.classList.remove('marked', 'coded');\n    });\n    updateTotal();\n  });\n\n  updateTotal();\n})();\n</script>",

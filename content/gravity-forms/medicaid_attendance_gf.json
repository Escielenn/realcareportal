    "content": "<div id=\"trans-grid\" class=\"rcc-wrap\">\n  <div class=\"rcc-head\">\n    <h3>Transportation Services - Mark AM/PM trips</h3>\n    <button type=\"button\" id=\"trans-clear\">Clear All</button>\n  </div>\n\n  <div class=\"grid-instructions\">\n    <strong>Warning:</strong> Only complete if you are an approved Non-Medical Transport Provider. Maximum 2 trips per day (one there, one back). Click AM or PM cells to mark transportation provided.\n  </div>\n\n  <div class=\"grid-container\">\n    <table class=\"day-grid\">\n      <thead>\n        <tr>\n          <th style=\"width:60px\">Time</th>\n          <th>1</th><th>2</th><th>3</th><th>4</th><th>5</th><th>6</th><th>7</th><th>8</th><th>9</th><th>10</th>\n          <th>11</th><th>12</th><th>13</th><th>14</th><th>15</th><th>16</th><th>17</th><th>18</th><th>19</th><th>20</th>\n          <th>21</th><th>22</th><th>23</th><th>24</th><th>25</th><th>26</th><th>27</th><th>28</th><th>29</th><th>30</th><th>31</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td style=\"background:#d9d9d9;font-weight:bold;cursor:default\">AM</td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"1\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"2\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"3\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"4\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"5\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"6\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"7\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"8\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"9\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"10\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"11\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"12\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"13\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"14\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"15\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"16\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"17\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"18\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"19\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"20\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"21\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"22\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"23\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"24\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"25\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"26\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"27\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"28\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"29\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"30\"></td>\n          <td class=\"trans-cell\" data-time=\"am\" data-day=\"31\"></td>\n        </tr>\n        <tr>\n          <td style=\"background:#d9d9d9;font-weight:bold;cursor:default\">PM</td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"1\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"2\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"3\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"4\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"5\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"6\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"7\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"8\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"9\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"10\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"11\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"12\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"13\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"14\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"15\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"16\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"17\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"18\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"19\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"20\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"21\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"22\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"23\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"24\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"25\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"26\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"27\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"28\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"29\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"30\"></td>\n          <td class=\"trans-cell\" data-time=\"pm\" data-day=\"31\"></td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n  \n  <p class=\"muted\">Your selections save automatically. Maximum 2 trips per day.</p>\n</div>\n\n<script>\n(function(){\n  const STORAGE_KEY = 'medicaid_transport_v1';\n  const clearBtn = document.getElementById('trans-clear');\n\n  function loadState(){\n    try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; }\n    catch(e){ return {}; }\n  }\n  function saveState(state){\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));\n  }\n\n  const state = loadState();\n\n  document.querySelectorAll('.trans-cell').forEach(td=>{\n    const time = td.getAttribute('data-time');\n    const day = td.getAttribute('data-day');\n    const key = time + '-' + day;\n    \n    if(state[key]){\n      td.textContent = 'X';\n      td.classList.add('marked');\n    }\n\n    td.addEventListener('click', function(){\n      const isMarked = td.classList.contains('marked');\n      if(isMarked){\n        td.textContent = '';\n        td.classList.remove('marked');\n        delete state[key];\n      } else {\n        td.textContent = 'X';\n        td.classList.add('marked');\n        state[key] = true;\n      }\n      saveState(state);\n      updateTotal();\n    });\n  });\n\n  function updateTotal(){\n    const s = loadState();\n    const total = Object.keys(s).length;\n    const input = document.querySelector('input[name=\"input_13\"]');\n    if(input) input.value = total;\n  }\n\n  clearBtn.addEventListener('click', ()=>{\n    if(!confirm('Clear all transportation trips?')) return;\n    localStorage.removeItem(STORAGE_KEY);\n    document.querySelectorAll('.trans-cell').forEach(td=>{\n      td.textContent = '';\n      td.classList.remove('marked');\n    });\n    updateTotal();\n  });\n\n  updateTotal();\n})();\n</script>",

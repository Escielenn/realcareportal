    "content": "<div style=\"margin:20px 0;padding:15px;background:#f0f8ff;border:2px solid #4a90e2;border-radius:5px\">\n  <h3 style=\"margin:0 0 12px;font-size:15px;font-weight:bold;color:#2c5aa0;text-align:center;border-bottom:2px solid #4a90e2;padding-bottom:8px\">Special Codes</h3>\n  <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;font-size:12px\">\n    <div style=\"padding:6px;background:#fff;border-left:4px solid #4a90e2\"><strong style=\"color:#2c5aa0\">E</strong> = Enrollment / Admission Date</div>\n    <div style=\"padding:6px;background:#fff;border-left:4px solid #28a745\"><strong style=\"color:#1e7e34\">X</strong> = Client in Residence</div>\n    <div style=\"padding:6px;background:#fff;border-left:4px solid #dc3545\"><strong style=\"color:#c82333\">H</strong> = Hospital Day / Nursing Home</div>\n    <div style=\"padding:6px;background:#fff;border-left:4px solid #6f42c1\"><strong style=\"color:#5a32a3\">R</strong> = Respite</div>\n    <div style=\"padding:6px;background:#fff;border-left:4px solid #fd7e14\"><strong style=\"color:#e35d00\">V</strong> = Visit to Family, Friends or Special Program</div>\n    <div style=\"padding:6px;background:#fff;border-left:4px solid #6c757d\"><strong style=\"color:#495057\">I</strong> = Ineligible Days</div>\n    <div style=\"padding:6px;background:#fff;border-left:4px solid #343a40\"><strong style=\"color:#1d2124\">T</strong> = Termination / Discharge Date</div>\n    <div style=\"padding:6px;background:#fff;border-left:4px solid #ffc107\"><strong style=\"color:#d39e00\">VT</strong> = Vacant Days Due to Termination</div>\n    <div style=\"padding:6px;background:#fff;border-left:4px solid #17a2b8\"><strong style=\"color:#117a8b\">J</strong> = Incarceration/Jail</div>\n  </div>\n  <p style=\"margin:10px 0 0;font-size:11px;font-style:italic;text-align:center;color:#555\">Double-click any date cell to enter a special code</p>\n</div>",

    "content": "<div id=\"menu-grid\" class=\"menu-wrap\">\n  <style>\n    .menu-wrap{font-family:Arial,sans-serif;font-size:13px;max-width:100%;margin:20px 0}\n    .menu-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px;flex-wrap:wrap;gap:10px}\n    .menu-header h3{margin:0;font-size:16px;font-weight:bold}\n    .menu-controls{display:flex;gap:8px;flex-wrap:wrap}\n    .menu-controls button{font-size:12px;padding:6px 12px;cursor:pointer;border:1px solid #666;background:#f0f0f0;border-radius:3px}\n    .menu-controls button:hover{background:#e0e0e0}\n    .menu-controls button.danger{background:#f44336;color:#fff;border-color:#da190b}\n    .menu-controls button.danger:hover{background:#da190b}\n    .grid-container{overflow-x:auto;border:2px solid #333;background:#e8dcc8;margin-bottom:15px}\n    table.menu-grid{width:100%;border-collapse:collapse;min-width:800px}\n    .menu-grid th,.menu-grid td{border:1px solid #666;padding:8px;vertical-align:top}\n    .menu-grid th{background:#d9d9d9;font-weight:bold;font-size:13px;text-align:center;color:#000}\n    .menu-grid .day-cell{background:#c8bba8;font-weight:bold;text-align:left;padding-left:12px;width:100px}\n    .menu-grid td{background:#f5f0e8}\n    .menu-grid textarea{width:100%;min-height:80px;border:1px solid #999;padding:6px;font-size:12px;font-family:Arial,sans-serif;box-sizing:border-box;resize:vertical;background:#fff}\n    .menu-grid textarea:focus{outline:2px solid #4CAF50;background:#ffffee}\n    .note{font-size:11px;color:#666;margin-top:10px;line-height:1.5}\n    .requirements{background:#fff8dc;padding:12px;border-left:4px solid #ff9800;margin:15px 0;font-size:12px}\n    .requirements strong{display:block;margin-bottom:5px}\n  </style>\n\n  <div class=\"menu-header\">\n    <h3>Weekly Meal Planning Grid</h3>\n    <div class=\"menu-controls\">\n      <button type=\"button\" id=\"menu-clear\" class=\"danger\">Clear All Meals</button>\n    </div>\n  </div>\n\n  <div class=\"requirements\">\n    <strong>📋 Requirements:</strong>\n    Write down 1 week of meals that an individual is provided every three months. Meals are to be wholesome and nutritious. Individuals need to be provided with a choice of meals and snacks.\n  </div>\n\n  <div class=\"grid-container\">\n    <table class=\"menu-grid\">\n      <thead>\n        <tr>\n          <th style=\"width:100px\"></th>\n          <th style=\"width:25%\">Breakfast</th>\n          <th style=\"width:25%\">Lunch</th>\n          <th style=\"width:25%\">Dinner</th>\n          <th style=\"width:25%\">Snacks</th>\n        </tr>\n      </thead>\n      <tbody id=\"menu-body\"></tbody>\n    </table>\n  </div>\n\n  <p class=\"note\">\n    💡 <strong>Tips:</strong> Be specific with meal descriptions. Include main dishes, sides, and beverages. Your entries save automatically as you type. Examples: \"Scrambled eggs, wheat toast, orange juice\" or \"Grilled chicken, steamed broccoli, brown rice, water\".\n  </p>\n</div>\n\n<script>\n(function(){\n  const STORAGE_KEY = 'menu_tracking_v1';\n  const tbody = document.getElementById('menu-body');\n  const clearBtn = document.getElementById('menu-clear');\n  \n  const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];\n  const meals = ['breakfast', 'lunch', 'dinner', 'snacks'];\n\n  function loadState(){\n    try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; }\n    catch(e){ return {}; }\n  }\n  \n  function saveState(){\n    const state = {};\n    days.forEach((day, dayIdx) => {\n      state[day] = {};\n      meals.forEach((meal, mealIdx) => {\n        const textarea = document.getElementById(`menu-${dayIdx}-${mealIdx}`);\n        if(textarea) state[day][meal] = textarea.value;\n      });\n    });\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));\n    updateHiddenField(state);\n  }\n\n  function updateHiddenField(state){\n    const hiddenField = document.querySelector('textarea[name=\"input_7\"]');\n    if(hiddenField){\n      hiddenField.value = JSON.stringify(state, null, 2);\n    }\n  }\n\n  function createGrid(){\n    const saved = loadState();\n    \n    days.forEach((day, dayIdx) => {\n      const tr = document.createElement('tr');\n      \n      const dayCell = document.createElement('td');\n      dayCell.className = 'day-cell';\n      dayCell.textContent = day;\n      tr.appendChild(dayCell);\n      \n      meals.forEach((meal, mealIdx) => {\n        const td = document.createElement('td');\n        const textarea = document.createElement('textarea');\n        textarea.id = `menu-${dayIdx}-${mealIdx}`;\n        textarea.setAttribute('aria-label', `${day} ${meal}`);\n        textarea.placeholder = `Enter ${meal} details...`;\n        \n        if(saved[day] && saved[day][meal]){\n          textarea.value = saved[day][meal];\n        }\n        \n        textarea.addEventListener('input', saveState);\n        \n        td.appendChild(textarea);\n        tr.appendChild(td);\n      });\n      \n      tbody.appendChild(tr);\n    });\n  }\n\n  clearBtn.addEventListener('click', () => {\n    if(!confirm('Clear all meal entries? This will erase all saved data.')) return;\n    \n    localStorage.removeItem(STORAGE_KEY);\n    \n    document.querySelectorAll('.menu-grid textarea').forEach(ta => {\n      ta.value = '';\n    });\n    \n    updateHiddenField({});\n  });\n\n  createGrid();\n  saveState();\n})();\n</script>",

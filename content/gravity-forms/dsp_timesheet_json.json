    "content": "<div id=\"timesheet-grid\" class=\"ts-wrap\">\n  <style>\n    .ts-wrap{font-family:Arial,sans-serif;font-size:13px;max-width:100%;margin:20px 0}\n    .ts-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px;flex-wrap:wrap;gap:10px}\n    .ts-header h3{margin:0;font-size:16px;font-weight:bold}\n    .ts-controls{display:flex;gap:8px;flex-wrap:wrap}\n    .ts-controls button{font-size:12px;padding:6px 12px;cursor:pointer;border:1px solid #666;background:#f0f0f0;border-radius:3px}\n    .ts-controls button:hover{background:#e0e0e0}\n    .ts-controls button.primary{background:#4CAF50;color:#fff;border-color:#45a049}\n    .ts-controls button.primary:hover{background:#45a049}\n    .ts-controls button.danger{background:#f44336;color:#fff;border-color:#da190b}\n    .ts-controls button.danger:hover{background:#da190b}\n    .grid-container{overflow-x:auto;border:2px solid #333;background:#fff;margin-bottom:15px}\n    table.ts-grid{width:100%;border-collapse:collapse;min-width:900px}\n    .ts-grid th,.ts-grid td{border:1px solid #666;padding:6px;text-align:center;vertical-align:middle}\n    .ts-grid th{background:#d9d9d9;font-weight:bold;font-size:12px;color:#000}\n    .ts-grid td{background:#f9f9f9;font-size:12px}\n    .ts-grid input[type=\"text\"],.ts-grid input[type=\"time\"],.ts-grid input[type=\"number\"]{width:100%;border:1px solid #ccc;padding:4px;font-size:12px;box-sizing:border-box}\n    .ts-grid input[type=\"number\"]{text-align:center}\n    .ts-grid .date-col{width:60px}\n    .ts-grid .initials-col{width:80px}\n    .ts-grid .service-col{width:100px}\n    .ts-grid .time-col{width:90px}\n    .ts-grid .hours-col{width:80px}\n    .ts-grid .trips-col{width:70px}\n    .ts-grid .actions-col{width:60px}\n    .ts-grid .total-row{background:#e8e8e8;font-weight:bold}\n    .ts-grid .total-row td{border-top:2px solid #333}\n    .ts-grid .hours-display{font-weight:bold;color:#1976d2;min-height:20px}\n    .delete-btn{background:#f44336;color:#fff;border:none;padding:4px 8px;cursor:pointer;border-radius:3px;font-size:11px}\n    .delete-btn:hover{background:#da190b}\n    .note{font-size:11px;color:#666;margin-top:10px}\n  </style>\n\n  <div class=\"ts-header\">\n    <h3>Direct Care Service Entries</h3>\n    <div class=\"ts-controls\">\n      <button type=\"button\" id=\"ts-add-row\" class=\"primary\">+ Add Row</button>\n      <button type=\"button\" id=\"ts-clear\" class=\"danger\">Clear All</button>\n    </div>\n  </div>\n\n  <div class=\"grid-container\">\n    <table class=\"ts-grid\">\n      <thead>\n        <tr>\n          <th class=\"date-col\">Date</th>\n          <th class=\"initials-col\">Client Initials</th>\n          <th class=\"service-col\">Service Type</th>\n          <th class=\"time-col\">Time In</th>\n          <th class=\"time-col\">Time Out</th>\n          <th class=\"hours-col\">Total Hours</th>\n          <th class=\"trips-col\"># of Trips</th>\n          <th class=\"actions-col\">Actions</th>\n        </tr>\n      </thead>\n      <tbody id=\"ts-body\"></tbody>\n      <tfoot>\n        <tr class=\"total-row\">\n          <td colspan=\"5\" style=\"text-align:right;padding-right:15px\"><strong>Total Direct Care Hours</strong></td>\n          <td><div id=\"ts-total-hours\" class=\"hours-display\">0.00</div></td>\n          <td colspan=\"2\"></td>\n        </tr>\n      </tfoot>\n    </table>\n  </div>\n\n  <p class=\"note\">\n    💡 <strong>Tip:</strong> Hours calculate automatically. Enter times in format like \"9:00 AM\" or \"14:30\". Your work saves automatically.\n  </p>\n</div>\n\n<script>\n(function(){\n  const STORAGE_KEY = 'dsp_timesheet_v1';\n  const tbody = document.getElementById('ts-body');\n  const totalHoursEl = document.getElementById('ts-total-hours');\n  const addBtn = document.getElementById('ts-add-row');\n  const clearBtn = document.getElementById('ts-clear');\n  let rowCount = 0;\n\n  function loadState(){\n    try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; }\n    catch(e){ return []; }\n  }\n  \n  function saveState(){\n    const rows = [];\n    tbody.querySelectorAll('tr').forEach(tr => {\n      const inputs = tr.querySelectorAll('input');\n      if(inputs.length >= 6){\n        rows.push({\n          date: inputs[0].value,\n          initials: inputs[1].value,\n          service: inputs[2].value,\n          timeIn: inputs[3].value,\n          timeOut: inputs[4].value,\n          trips: inputs[5].value\n        });\n      }\n    });\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(rows));\n    updateHiddenField();\n  }\n\n  function calculateHours(timeIn, timeOut){\n    if(!timeIn || !timeOut) return 0;\n    try{\n      const parseTime = (t) => {\n        t = t.trim().toUpperCase();\n        let hours = 0, minutes = 0;\n        if(t.includes('AM') || t.includes('PM')){\n          const isPM = t.includes('PM');\n          t = t.replace(/AM|PM/g, '').trim();\n          const parts = t.split(':');\n          hours = parseInt(parts[0]) || 0;\n          minutes = parseInt(parts[1]) || 0;\n          if(isPM && hours !== 12) hours += 12;\n          if(!isPM && hours === 12) hours = 0;\n        } else {\n          const parts = t.split(':');\n          hours = parseInt(parts[0]) || 0;\n          minutes = parseInt(parts[1]) || 0;\n        }\n        return hours + (minutes / 60);\n      };\n      \n      let start = parseTime(timeIn);\n      let end = parseTime(timeOut);\n      if(end < start) end += 24;\n      return Math.max(0, end - start);\n    } catch(e){\n      return 0;\n    }\n  }\n\n  function updateRowHours(tr){\n    const inputs = tr.querySelectorAll('input');\n    if(inputs.length < 5) return;\n    const timeIn = inputs[3].value;\n    const timeOut = inputs[4].value;\n    const hoursDisplay = tr.querySelector('.hours-display');\n    const hours = calculateHours(timeIn, timeOut);\n    if(hoursDisplay) hoursDisplay.textContent = hours.toFixed(2);\n    updateTotalHours();\n  }\n\n  function updateTotalHours(){\n    let total = 0;\n    tbody.querySelectorAll('tr').forEach(tr => {\n      const display = tr.querySelector('.hours-display');\n      if(display){\n        const val = parseFloat(display.textContent) || 0;\n        total += val;\n      }\n    });\n    totalHoursEl.textContent = total.toFixed(2);\n    \n    const hiddenTotal = document.querySelector('input[name=\"input_6\"]');\n    if(hiddenTotal) hiddenTotal.value = total.toFixed(2);\n  }\n\n  function updateHiddenField(){\n    const hiddenField = document.querySelector('textarea[name=\"input_7\"]');\n    if(!hiddenField) return;\n    \n    const data = [];\n    tbody.querySelectorAll('tr').forEach(tr => {\n      const inputs = tr.querySelectorAll('input');\n      const hoursDisplay = tr.querySelector('.hours-display');\n      if(inputs.length >= 6){\n        data.push({\n          date: inputs[0].value,\n          initials: inputs[1].value,\n          service: inputs[2].value,\n          timeIn: inputs[3].value,\n          timeOut: inputs[4].value,\n          hours: hoursDisplay ? hoursDisplay.textContent : '0.00',\n          trips: inputs[5].value\n        });\n      }\n    });\n    hiddenField.value = JSON.stringify(data, null, 2);\n  }\n\n  function createRow(data = {}){\n    const tr = document.createElement('tr');\n    tr.innerHTML = `\n      <td><input type=\"text\" placeholder=\"1-31\" maxlength=\"2\" value=\"${data.date || ''}\" /></td>\n      <td><input type=\"text\" placeholder=\"Initials\" maxlength=\"10\" value=\"${data.initials || ''}\" /></td>\n      <td><input type=\"text\" placeholder=\"Type\" value=\"${data.service || ''}\" /></td>\n      <td><input type=\"text\" placeholder=\"9:00 AM\" value=\"${data.timeIn || ''}\" /></td>\n      <td><input type=\"text\" placeholder=\"5:00 PM\" value=\"${data.timeOut || ''}\" /></td>\n      <td><div class=\"hours-display\">0.00</div></td>\n      <td><input type=\"number\" min=\"0\" max=\"10\" placeholder=\"0\" value=\"${data.trips || ''}\" /></td>\n      <td><button type=\"button\" class=\"delete-btn\">Delete</button></td>\n    `;\n    \n    const inputs = tr.querySelectorAll('input');\n    inputs.forEach(input => {\n      input.addEventListener('input', () => {\n        if(input === inputs[3] || input === inputs[4]) updateRowHours(tr);\n        saveState();\n      });\n    });\n    \n    const deleteBtn = tr.querySelector('.delete-btn');\n    deleteBtn.addEventListener('click', () => {\n      if(confirm('Delete this entry?')){\n        tr.remove();\n        saveState();\n        updateTotalHours();\n      }\n    });\n    \n    tbody.appendChild(tr);\n    if(data.timeIn && data.timeOut) updateRowHours(tr);\n    rowCount++;\n  }\n\n  addBtn.addEventListener('click', () => {\n    createRow();\n    saveState();\n  });\n\n  clearBtn.addEventListener('click', () => {\n    if(!confirm('Clear all timesheet entries? This cannot be undone.')) return;\n    tbody.innerHTML = '';\n    localStorage.removeItem(STORAGE_KEY);\n    totalHoursEl.textContent = '0.00';\n    updateHiddenField();\n  });\n\n  const saved = loadState();\n  if(saved.length > 0){\n    saved.forEach(row => createRow(row));\n  } else {\n    for(let i = 0; i < 5; i++) createRow();\n  }\n  \n  updateTotalHours();\n})();\n</script>",

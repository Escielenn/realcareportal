   {
    "type": "html",
    "id": 999,
    "label": "Auto-Add Days Script",
    "displayOnly": true,
    "content": "<script>\n(function() {\n  function ensureRows(listField, target) {\n    try {\n      var $list = listField.querySelector('table.gfield_list');\n      if (!$list) return;\n      var addBtn = listField.querySelector('.add_list_item, .gform-icon--plus, .gfield_list_icons .add');\n      if (!addBtn) return;\n      var current = $list.querySelectorAll('tbody tr').length;\n      for (var i=current; i<target; i++) { addBtn.click(); }\n    } catch(e) { console.warn('Auto-rows error', e); }\n  }\n  function toDropdowns(listField) {\n    var tbody = listField.querySelector('tbody');\n    if (!tbody) return;\n    var headers = Array.from(listField.querySelectorAll('thead th')).map(th => th.innerText.toLowerCase());\n    Array.from(tbody.querySelectorAll('tr')).forEach(function(tr){\n      Array.from(tr.querySelectorAll('td input[type=\"text\"]')).forEach(function(inp, idx){\n        var isYN = /\\(Y\\/N\\/R\\)|\\bY\\b|\\bN\\b|\\bR\\b|met\\/exceeded|communication|appointments|common|bedding|towels|dishes|fed|walk|teeth|hair|shower|clothing|supervision|activity/i.test(headers[idx] || '');\n        // 'Day' & 'desc' columns remain text\n        var isDay = /day/.test((headers[idx]||''));\n        var isDesc = /desc/.test((headers[idx]||''));\n        if (isYN && !isDay && !isDesc) {\n          var sel = document.createElement('select');\n          sel.className = inp.className;\n          ['','Y','N','R'].forEach(function(opt){\n            var o = document.createElement('option'); o.value = opt; o.textContent = opt;\n            sel.appendChild(o);\n          });\n          sel.name = inp.name;\n          sel.value = (inp.value||'').toUpperCase();\n          inp.parentNode.replaceChild(sel, inp);\n        }\n      });\n    });\n  }\n  function init() {\n    document.querySelectorAll('.gfield_list').forEach(function(tbl){ tbl.style.tableLayout='auto'; });\n    var listFields = document.querySelectorAll('.gfield--type-list');\n    listFields.forEach(function(field){ ensureRows(field, 31); toDropdowns(field); });\n  }\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else { init(); }\n})();\n</script>"
   }
  ]

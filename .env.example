NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Shows the demo account buttons on the login page. Never set in production.
NEXT_PUBLIC_DEMO_MODE=true
# Production only: read access to the live Wix training site for the one-step import (Import from Wix).
# Never set these on the demo project; the database also refuses real Wix data while demo mode is on.
WIX_API_KEY=
WIX_SITE_ID=

# Billing questions contact shown to providers (Real Care business line, never a personal phone). Empty = hidden.
NEXT_PUBLIC_BILLING_PHONE=
NEXT_PUBLIC_BILLING_EMAIL=
